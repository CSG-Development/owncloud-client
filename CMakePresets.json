{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "WITH_CRASHREPORTER": "OFF",
        "WITH_AUTO_UPDATER": "OFF",
        "CMAKE_PREFIX_PATH": "$env{DEPS_ROOT};$env{QT_ROOT}",
        "OPENSSL_ROOT_DIR": "$env{DEPS_ROOT}/openssl",
        "ZLIB_ROOT": "$env{DEPS_ROOT}",
        "ZLIB_INCLUDE_DIR": "$env{DEPS_ROOT}/include",
        "ZLIB_LIBRARY": "$env{DEPS_ROOT}/lib/zlib.lib",
        "SQLite3_INCLUDE_DIR": "$env{DEPS_ROOT}/include",
        "SQLite3_LIBRARY": "$env{DEPS_ROOT}/lib/sqlite3.lib",
        "BUILD_DOC": "OFF",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "displayName": "Release",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "release-ninja",
      "displayName": "Release (Ninja)",
      "inherits": "base",
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "local-debug",
      "displayName": "Local Debug (Ninja, no installer)",
      "inherits": "base",
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/build/debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_INSTALLER": "OFF",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build/debug",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/build/debug"
      }
    },
    {
      "name": "local-release",
      "displayName": "Local Release (Ninja, no installer)",
      "inherits": "base",
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "host=x64",
        "strategy": "external"
      },
      "binaryDir": "${sourceDir}/build/release",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_INSTALLER": "OFF",
        "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build/release",
        "CMAKE_LIBRARY_OUTPUT_DIRECTORY": "${sourceDir}/build/release"
      }
    },
    {
      "name": "relwithdebinfo",
      "displayName": "RelWithDebInfo",
      "inherits": "base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "macos-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "WITH_CRASHREPORTER": "OFF",
        "WITH_AUTO_UPDATER": "OFF",
        "CMAKE_PREFIX_PATH": "$env{DEPS_ROOT};$env{QT_ROOT}",
        "OPENSSL_ROOT_DIR": "$env{OPENSSL_ROOT_DIR}",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13",
        "BUILD_DOC": "OFF",
        "BUILD_TESTING": "OFF"
      }
    },
    {
      "name": "macos-debug",
      "displayName": "Debug (macOS)",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-release",
      "displayName": "Release (macOS)",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64"
      }
    },
    {
      "name": "macos-relwithdebinfo",
      "displayName": "RelWithDebInfo (macOS)",
      "inherits": "macos-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_OSX_ARCHITECTURES": "arm64;x86_64"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "configuration": "Release"
    },
    {
      "name": "release-ninja",
      "configurePreset": "release-ninja"
    },
    {
      "name": "local-debug",
      "configurePreset": "local-debug"
    },
    {
      "name": "local-release",
      "configurePreset": "local-release"
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "macos-debug",
      "configurePreset": "macos-debug"
    },
    {
      "name": "macos-release",
      "configurePreset": "macos-release"
    },
    {
      "name": "macos-relwithdebinfo",
      "configurePreset": "macos-relwithdebinfo"
    }
  ]
}
