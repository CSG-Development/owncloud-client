var APP_NAME = @APP_DISPLAY_NAME_JS@;
var MACOS_BUNDLE_EXECUTABLE = @MACOS_BUNDLE_EXECUTABLE_JS@;
var MACOS_USER_DATA_DIR = @MACOS_USER_DATA_DIR_JS@;
var MACOS_APP_BUNDLE_ID = @MACOS_APP_BUNDLE_ID_JS@;
var MACOS_FINDER_SYNC_EXTENSION_ID = @MACOS_FINDER_SYNC_EXTENSION_ID_JS@;
var MACOS_GROUP_CONTAINER_ID = @MACOS_GROUP_CONTAINER_ID_JS@;

var invokingUserHome = "";

function Controller()
{
    installer.setDefaultPageVisible(QInstaller.TargetDirectory, false);

    if (systemInfo.kernelType === "darwin") {
        invokingUserHome = installer.environmentVariable("HOME");

        connectSignal(installer.uninstallationStarted, this, Controller.prototype.handleUninstallationStarted);
        connectSignal(installer.uninstallationFinished, this, Controller.prototype.handleUninstallationFinished);
    }

    setupPageListTitles();
}

function setupPageListTitles()
{
    var titles = [
        [QInstaller.Introduction,         "Welcome"],
        [QInstaller.ComponentSelection,   "Select Components"],
        [QInstaller.LicenseCheck,         "License Agreement"],
        [QInstaller.ReadyForInstallation, "Summary"],
        [QInstaller.PerformInstallation,  "Installing"],
        [QInstaller.InstallationFinished, "Finished"]
    ];
    for (var i = 0; i < titles.length; ++i) {
        var page = gui.pageById(titles[i][0]);
        if (page == null)
            continue;
        try {
            page.setPageListTitle(titles[i][1]);
        } catch (e) {
            console.log("setupPageListTitles: " + titles[i][1] + " -> " + e);
        }
    }
}

Controller.prototype.IntroductionPageCallback = function()
{
    var page = gui.currentPageWidget();
    if (page != null) {
        page.title = "Welcome to " + APP_NAME;
        if (page.MessageLabel != null) {
            page.MessageLabel.setText(
                "The Setup Wizard will install " + APP_NAME + " on your computer. " +
                "You will be guided through the steps necessary to install this software.");
        }
    }
}

Controller.prototype.FinishedPageCallback = function()
{
    if (systemInfo.kernelType !== "darwin" || isUninstaller() || !installerSucceeded()) {
        return;
    }

    var page = gui.currentPageWidget();
    if (page != null && page.LocationLabel != null) {
        page.LocationLabel.setText("/Applications");
    }
}

Controller.prototype.handleUninstallationStarted = function()
{
    stopMacOSApplication();
}

Controller.prototype.handleUninstallationFinished = function()
{
    if (installerSucceeded()) {
        removeMacOSUserData();
    }
}

function stopMacOSApplication()
{
    if (systemInfo.kernelType !== "darwin" || !isUninstaller()) {
        return;
    }

    installer.execute("/bin/sh", [
        "-c",
        "killall " + shellSingleQuote(MACOS_BUNDLE_EXECUTABLE) + " >/dev/null 2>&1; exit 0"
    ]);
}

function removeMacOSUserData()
{
    if (systemInfo.kernelType !== "darwin" || !isUninstaller()) {
        return;
    }

    if (invokingUserHome === "") {
        return;
    }

    var home        = shellSingleQuote(invokingUserHome);
    var userDataDir = shellSingleQuote(MACOS_USER_DATA_DIR);
    var appId       = shellSingleQuote(MACOS_APP_BUNDLE_ID);
    var extId       = shellSingleQuote(MACOS_FINDER_SYNC_EXTENSION_ID);
    var groupId     = shellSingleQuote(MACOS_GROUP_CONTAINER_ID);

    var cleanupScript =
        "set +e; " +
        "L=" + home + "\"/Library\"; " +
        "UID_OF_HOME=$(stat -f%u " + home + " 2>/dev/null); " +
        "[ -n \"$UID_OF_HOME\" ] && launchctl bootout \"gui/$UID_OF_HOME/\"" + appId + " >/dev/null 2>&1; " +
        "rm -rf " +
            "\"$L/LaunchAgents/\"" + appId + "\".plist\" " +
            "\"$L/Preferences/\"" + userDataDir + " " +
            "\"$L/Caches/\"" + userDataDir + " " +
            "\"$L/Preferences/\"" + appId + "\".plist\" " +
            "\"$L/Containers/\"" + appId + " " +
            "\"$L/Containers/\"" + extId + " " +
            "\"$L/Group Containers/\"" + groupId + " " +
            "\"$L/Group Containers/\"" + appId + "; " +
        "exit 0";

    installer.execute("/bin/sh", ["-c", cleanupScript]);
}

function installerSucceeded()
{
    var status = installer.status;
    if (typeof status === "function") {
        status = installer.status();
    }

    return status === QInstaller.Success;
}

function isUninstaller()
{
    var value = installer.isUninstaller;
    if (typeof value === "function") {
        return value();
    }

    return value === true;
}

function shellSingleQuote(value)
{
    return "'" + String(value).replace(/'/g, "'\\''") + "'";
}

function connectSignal(signal, receiver, handler)
{
    if (signal != null && typeof signal.connect === "function") {
        signal.connect(receiver, handler);
    }
}
