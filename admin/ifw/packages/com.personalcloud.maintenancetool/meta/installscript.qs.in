var MAINTENANCE_TOOL_BUNDLE = "/Applications/@MAINTENANCE_TOOL_NAME@.app";

function Component()
{
    component.ifwVersion = installer.value("FrameworkVersion");
    installer.installationStarted.connect(this, Component.prototype.onInstallationStarted);
}

Component.prototype.createOperationsForArchive = function(archive)
{
    if (installer.value("os") === "mac") {
        component.addOperation("Extract", archive, "/Applications");
    } else {
        component.addOperation("Extract", archive, "@TargetDir@");
    }
}

Component.prototype.onInstallationStarted = function()
{
    if (!component.installationRequested() && !component.updateRequested()) {
        return;
    }

    if (installer.value("os") !== "mac") {
        return;
    }

    component.installerbaseBinaryPath = MAINTENANCE_TOOL_BUNDLE;
    installer.setInstallerBaseBinary(component.installerbaseBinaryPath);
}
