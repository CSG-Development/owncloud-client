<?xml version="1.0" encoding="utf-8"?>

<Include>

    <?define AppVendor = "Seagate Technologies LLC" ?>
    <?define AppName = "Curator Files" ?>
    <?define AppShortName = "curator" ?>

    <?define AppIcon = "curator.ico" ?>
    <?define AppExe = "Curator Files.exe" ?>

	<?define AppCommandOpenUrlScheme = "oc" ?>

    <!-- App Version -->
    <?define VerMajor = "1" ?>
    <?define VerMinor = "0" ?>
    <?define VerRevision = "4" ?>
    <?define VerBuild = "1" ?>
    <?define VerStd = "$(var.VerMajor).$(var.VerMinor).$(var.VerRevision)" ?>
    <?define VerFull = "$(var.VerStd).$(var.VerBuild)" ?>
