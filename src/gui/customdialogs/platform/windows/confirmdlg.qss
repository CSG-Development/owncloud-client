.helper_frame { border: none; }

#frame {border-radius: 7px;}

#frameContent {
    border-bottom: none;
    border-radius: 7px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}
#frameButtons {
    border-top: none;
    border-radius: 7px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}

#btnIcon, #btnClose, #btnIconWarn { border: none; background: transparent; }
#lblHeader {font-size: 20px;}
#lblText {font-size: 14px;}

#btnAccept,
#btnReject {
    border-radius: 4px;
    font-size: 14px;
}

[theme="light"] #frame {
    background: #FFFFFF;
}

[theme="light"] #frameContent {
    border-top: 1px solid rgba(203, 205, 211, 1);
    border-left: 1px solid rgba(203, 205, 211, 1);
    border-right: 1px solid rgba(203, 205, 211, 1);
    background: #FFFFFF;
}

[theme="light"] #frameButtons {
    border-left: 1px solid rgba(203, 205, 211, 1);
    border-right: 1px solid rgba(203, 205, 211, 1);
    border-bottom: 1px solid rgba(203, 205, 211, 1);
    background: rgba(240, 241, 245, 1);
}

/* Accept button */
[theme="light"] #btnAccept {
    border: 1px solid rgb(25, 118, 210);
    background: rgb(25, 118, 210);
    color: rgba(255, 255, 255, 0.87);
}

[theme="light"] #btnAccept:hover {
    border: 1px solid rgb(30, 136, 229);
    background: rgb(30, 136, 229);
    color: rgba(255, 255, 255, 0.87);
}

[theme="light"] #btnAccept:pressed {
    border: 1px solid rgb(20, 92, 164);
    background: rgb(20, 92, 164);
    color: rgba(255, 255, 255, 0.7);
}

/* Reject button */
[theme="light"] #btnReject {
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgb(223, 223, 223);
    color: rgba(0, 0, 0, 0.87);
}

[theme="light"] #btnReject:hover {
    background: rgb(247, 247, 247);
    border: 1px solid rgb(223, 223, 223);
    color: rgba(0, 0, 0, 0.87);
}

[theme="light"] #btnReject:pressed {
    background: rgb(242, 243, 244);
    border: 1px solid rgb(223, 223, 223);
    color: rgba(0, 0, 0, 0.6);
}

[theme="light"] #lblHeader,
[theme="light"] #lblText {color: rgba(0, 0, 0, 0.87);}

[theme="dark"] #frame {
    background: #000000;
}

[theme="dark"] #frameContent {
    border-top: 1px solid rgba(97, 97, 97, 1);
    border-left: 1px solid rgba(97, 97, 97, 1);
    border-right: 1px solid rgba(97, 97, 97, 1);
    background: rgba(61, 62, 65, 1);
}

[theme="dark"] #frameButtons {
    border-left: 1px solid rgba(97, 97, 97, 1);
    border-right: 1px solid rgba(97, 97, 97, 1);
    border-bottom: 1px solid rgba(97, 97, 97, 1);
    background: rgba(61, 62, 65, 1);
}

/* Accept button */
[theme="dark"] #btnAccept {
    border: 1px solid rgba(100, 181, 246, 1);
    background: rgb(100, 181, 246);
    color: rgba(0, 0, 0, 0.87);
}

[theme="dark"] #btnAccept:hover {
    border: 1px solid rgb(144, 202, 249);
    background: rgb(144, 202, 249);
    color: rgba(0, 0, 0, 0.87);
}

[theme="dark"] #btnAccept:pressed {
    border: 1px solid rgb(53, 158, 243);
    background: rgb(53, 158, 243);
    color: rgba(0, 0, 0, 0.6);
}

/* Reject button */
[theme="dark"] #btnReject {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgb(85, 85, 85);
    color: rgba(255, 255, 255, 0.87);
}

[theme="dark"] #btnReject:hover {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgb(85, 85, 85);
    color: rgba(255, 255, 255, 0.87);
}

[theme="dark"] #btnReject:pressed {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgb(85, 85, 85);
    color: rgba(255, 255, 255, 0.7);
}

[theme="dark"] #lblHeader,
[theme="dark"] #lblText {color: rgba(255, 255, 255, 0.87);}
