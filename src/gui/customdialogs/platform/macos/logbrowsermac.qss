.helper_frame { border: none; }

#frame {border-radius: 7px;}

#frameContent {
    border: none;
}

#btnIcon {
    border: none;
    padding: 0;
    margin: 0;
}

#frameButtons {
    border-top: none;
    border-radius: 7px;
    border-top-left-radius: 0px;
    border-top-right-radius: 0px;
}
#frameTitle {
    border-bottom: none;
    border-radius: 7px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;
}

#btnClose,
#btnOpenFolder {
    border-radius: 6px;
    font-size: 14px;
    padding-left: 14px;
    padding-right: 14px;
}

#lblWarn,
#lblText,
#lblPath,
#lblLocation,
#chkEnableLogging,
#chkLogHttp,
#lblFilesKeep,
#lblFooter,
#edFilesKeep {
    font-size: 14px;
}

#lblHeaderTitle {
    font-size: 16px;
    font-weight: bold;
}

#frameOpenFolderBtn,
#frameCloseBtn {
    border-radius: 6px;
}

[theme="light"] #frame {background: #FFFFFF;}
[theme="light"] #frameTitle {
    background: #FFFFFF;
    border-left: 1px solid rgba(203, 205, 211, 1);
    border-right: 1px solid rgba(203, 205, 211, 1);
    border-top: 1px solid rgba(203, 205, 211, 1);
}

[theme="light"] #frameContent {
    background: #FFFFFF;
    border-left: 1px solid rgba(203, 205, 211, 1);
    border-right: 1px solid rgba(203, 205, 211, 1);
}

[theme="light"] #frameButtons {
    background: rgba(240, 241, 245, 1);
    border-left: 1px solid rgba(203, 205, 211, 1);
    border-right: 1px solid rgba(203, 205, 211, 1);
    border-bottom: 1px solid rgba(203, 205, 211, 1);
}

[theme="light"] #btnOpenFolder {
    border: 1px solid rgb(25, 118, 210);
    background: rgb(25, 118, 210);
    color: rgba(255, 255, 255, 0.87);
}

[theme="light"] #btnOpenFolder:hover {
    border: 1px solid rgb(30, 136, 229);
    background: rgb(30, 136, 229);
    color: rgba(255, 255, 255, 0.87);
}

[theme="light"] #btnOpenFolder:pressed {
    border: 1px solid rgb(20, 92, 164);
    background: rgb(20, 92, 164);
    color: rgba(255, 255, 255, 0.7);
}

[theme="light"] #btnClose {
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgb(223, 223, 223);
    color: rgba(0, 0, 0, 0.87);
}

[theme="light"] #btnClose:hover {
    background: rgb(247, 247, 247);
    border: 1px solid rgb(223, 223, 223);
    color: rgba(0, 0, 0, 0.87);
}

[theme="light"] #btnClose:pressed {
    background: rgb(242, 243, 244);
    border: 1px solid rgb(223, 223, 223);
    color: rgba(0, 0, 0, 0.6);
}

[theme="light"] #lblWarn {
    color: rgba(244, 67, 54, 1);
}


[theme="dark"] #frame {background: #000000;}
[theme="dark"] #frameTitle {
    background: #000000;
    border-top: 1px solid rgb(97, 97, 97);
    border-left: 1px solid rgb(97, 97, 97);
    border-right: 1px solid rgb(97, 97, 97);
}

[theme="dark"] #frameContent {
    background: rgb(38, 38, 41);
    border-left: 1px solid rgb(97, 97, 97);
    border-right: 1px solid rgb(97, 97, 97);
}

[theme="dark"] #frameButtons {
    border-left: 1px solid rgb(97, 97, 97);
    border-right: 1px solid rgb(97, 97, 97);
    border-bottom: 1px solid rgb(97, 97, 97);
    background: rgb(61, 61, 65);
}


[theme="dark"] #btnOpenFolder {
    border: 1px solid rgba(100, 181, 246, 1);
    background: rgb(100, 181, 246);
    color: rgba(0, 0, 0, 0.87);
}

[theme="dark"] #btnOpenFolder:hover {
    border: 1px solid rgb(144, 202, 249);
    background: rgb(144, 202, 249);
    color: rgba(0, 0, 0, 0.87);
}

[theme="dark"] #btnOpenFolder:pressed {
    border: 1px solid rgb(53, 158, 243);
    background: rgb(53, 158, 243);
    color: rgba(0, 0, 0, 0.6);
}

[theme="dark"] #btnClose {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgb(85, 85, 85);
    color: rgba(255, 255, 255, 0.87);
}

[theme="dark"] #btnClose:hover {
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgb(85, 85, 85);
    color: rgba(255, 255, 255, 0.87);
}

[theme="dark"] #btnClose:pressed {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgb(85, 85, 85);
    color: rgba(255, 255, 255, 0.7);
}

[theme="dark"] #lblWarn {
    color: rgba(242, 143, 140, 1);
}
