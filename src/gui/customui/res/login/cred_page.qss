.helper_frame { border: none; }

#frameContent { border-radius: 24px; }

#lblImage { background-image: url(":/res/Files-app-icon-gradient.svg"); }
#btnImage { border: none; background: transparent; }
#btnLogo { border: none; background: transparent; }
#lblAppName { font-size: 34px; }
#lblEmail { font-size: 16px; }
#showPasswordButton { border: none; }
#frameErrorMessageInternal { border: 1px solid transparent; border-radius: 12px; }

.button_accent {
    border-color: transparent;
    border-width: 1px;
    border-radius: 20px;
    font-size: 14px;
    font-weight: bold;
}

.button_normal {
    background: transparent;
    border-radius: 20px;
    font-size: 14px;
    font-weight: bold;
}

.text_button {
    font-size: 14px;
    font-weight: bold;
    outline: none;
    border: 1px solid transparent;
    border-radius: 18px;
    background: transparent;
}

.button_icon_tool {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 20px;
}

/*** Light theme */

[theme="light"] #frameContent { background-color: @wizardCardBackgroundLight; }
[theme="light"] #lblEmail {color: rgba(0, 0, 0, 0.87);}

[theme="light"] #showPasswordButton { image: url(":/res/login/eye_closed_light.svg"); }
[theme="light"] #showPasswordButton:checked { image: url(":/res/login/eye_open_light.svg"); }

[theme="light"] .button_accent {background: @primaryLight; color: @onPrimaryLight;}
[theme="light"] .button_accent:hover { background: @primaryHoverLight; }
[theme="light"] .button_accent:pressed { background: @primaryPressedLight; }

[theme="light"] .button_normal { border: 1px solid @outlineButtonLight; color: @outlineButtonLight; }
[theme="light"] .button_normal:hover { background: @outlineButtonHoverBackgroundLight; border-color: @outlineButtonHoverLight; color: @outlineButtonHoverLight; }
[theme="light"] .button_normal:pressed { background: @outlineButtonPressedBackgroundLight; border-color: @outlineButtonPressedLight; color: @outlineButtonPressedLight; }

[theme="light"] .button_accent:disabled { background: @primaryDisabledLight; color: @onPrimaryDisabledLight; }
[theme="light"] .button_normal:disabled { background: transparent; border-color: @outlineButtonDisabledLight; color: @outlineButtonDisabledLight; }

[theme="light"] .text_button { color: @textButtonLight; }
[theme="light"] .text_button:disabled { color: @textButtonDisabledLight; }
[theme="light"] .text_button:hover { background: @flatButtonHoverBackgroundLight; color: @textButtonHoverLight; }
[theme="light"] .text_button:pressed { background: @flatButtonPressedBackgroundLight; color: @textButtonPressedLight; }

[theme="light"] .button_icon_tool:hover { background: @flatButtonHoverBackgroundLight; }
[theme="light"] .button_icon_tool:pressed { background: @flatButtonPressedBackgroundLight; }

[theme="light"] #frameErrorMessageInternal { background: rgba(244,67,54,31); }
[theme="light"] #lblErrorIcon { image: url(":/res/login/error_light.svg"); }
[theme="light"] #lblErrorText { color: rgba(0,0,0,222); }
[theme="light"] #lblAppName { color: rgba(0, 0, 0, 0.87); }


/*** Dark theme */

[theme="dark"] #frameContent { background-color: @wizardCardBackgroundDark; }
[theme="dark"] #lblEmail { color: rgba(255, 255, 255, 0.87); }

[theme="dark"] #showPasswordButton { image: url(":/res/login/eye_closed_dark.svg"); }
[theme="dark"] #showPasswordButton:checked { image: url(":/res/login/eye_open_dark.svg"); }

[theme="dark"] .button_accent { background: @primaryDark; color: @onPrimaryDark; }
[theme="dark"] .button_accent:hover { background: @primaryHoverDark; }
[theme="dark"] .button_accent:pressed { background: @primaryPressedDark; }

[theme="dark"] .button_normal { border: 1px solid @outlineButtonDark; color: @outlineButtonDark; }
[theme="dark"] .button_normal:hover { background: @outlineButtonHoverBackgroundDark; border-color: @outlineButtonHoverDark; color: @outlineButtonHoverDark; }
[theme="dark"] .button_normal:pressed { background: @outlineButtonPressedBackgroundDark; border-color: @outlineButtonPressedDark; color: @outlineButtonPressedDark; }

[theme="dark"] .button_accent:disabled { background: @primaryDisabledDark; color: @onPrimaryDisabledDark; }
[theme="dark"] .button_normal:disabled { background: transparent; border-color: @outlineButtonDisabledDark; color: @outlineButtonDisabledDark; }

[theme="dark"] .text_button { color: @textButtonDark; }
[theme="dark"] .text_button:disabled { color: @textButtonDisabledDark; }
[theme="dark"] .text_button:hover { background: @flatButtonHoverBackgroundDark; color: @textButtonHoverDark; }
[theme="dark"] .text_button:pressed { background: @flatButtonPressedBackgroundDark; color: @textButtonPressedDark; }

[theme="dark"] .button_icon_tool:hover { background: @flatButtonHoverBackgroundDark; }
[theme="dark"] .button_icon_tool:pressed { background: @flatButtonPressedBackgroundDark; }

[theme="dark"] #frameErrorMessageInternal { background: rgba(242,143,140,61); }
[theme="dark"] #lblErrorIcon { image: url(":/res/login/error_dark.svg"); }
[theme="dark"] #lblErrorText { color: rgba(255,255,255,222); }
[theme="dark"] #lblAppName { color: rgba(255, 255, 255, 0.87); }
