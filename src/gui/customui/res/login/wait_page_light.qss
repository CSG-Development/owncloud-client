#frameContent {
    background-color: #FFFFFF;
    border-radius: 24px;
}

#frame,
#frameHalign,
#frameContent,
#frameBusy,
#frameLogo,
#frameImage,
#frameText,
#frameProcessText {
    border: none;
}


#lblImage {
