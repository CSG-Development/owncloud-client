#frameInnerVert,
#frameInnerHoriz {
    border: none;
}

#frame {
    background-color: #262729;
    border-radius: 28px;
}

#frameButtons {
    border: none;
}

#lblHeader {
    font-size: 24px;
}

#lblText {
    font-size: 16px;
}

#lblError {
    font-size: 12px;
    color: rgba(242, 143, 140, 1);
}

#btnResendCode,
#btnSkip,
#btnAllowAccess {
    color: rgba(100, 181, 246, 1);
    font-size: 14px;
    min-height: 40px;
    max-height: 40px;
    outline: none;
    border: 1px solid transparent;
    border-radius: 20px;
    background: transparent;
}

#btnResendCode:disabled,
#btnSkip:disabled,
#btnAllowAccess:disabled {
    color: rgba(158, 158, 158, 1);
}

#btnResendCode:hover,
#btnSkip:hover,
#btnAllowAccess:hover {
    background: rgba(144, 202, 249, 0.12);
}

#btnResendCode:pressed,
#btnSkip:pressed,
#btnAllowAccess:pressed {
    background: rgba(144, 202, 249, 0.3);
}
