#frameContent {
    background-color: #262729;
    border-radius: 24px;
}

#frame,
#frameHalign,
#frameContent,
#frameButton,
#frameLogo,
#frameText,
#frameToolbar {
    border: none;
}

#lblHeader {
    font-size: 22px;
    font: "Segoe UI";
}

#lblInfo1,
#lblInfo2,
#lblInfo3,
#lblInfo4,
#lblInfo5,
#lblInfo6,
#lblInfo7 {
    font-size: 14px;
}

#btnUnused {
    background: transparent;
    border: 1px solid transparent;
}

/**** Retry button */
#btnRetry {
    background: #64B5F6;
    border-color: transparent;
    border-width: 1px;
    border-radius: 20px;
    color: #212121;
    font-size: 14px;
}

#btnRetry:hover {
    background: rgba(144, 202, 249, 1);
}

#btnRetry:pressed {
    background: rgba(53, 158, 243, 1);
}

#btnRetry:disabled {
    background: #616161;
    color: #9E9E9E;
}

#btnBack {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 20px;
}

#btnBack:hover {
    background: rgba(144, 202, 249, 0.12);
}

#btnBack:pressed {
    background: rgba(144, 202, 249, 0.3);
}

QToolTip {
    background: #B8B8B8;
    color: rgba(0,0,0,222);
    border: 1px solid transparent;
    border-radius: 4px;
}
