#frame {
    background: #FFFFFF;
    border-radius: 28px;
}

#frameButtons {
    border: none;
}

#lblHeader {
    font-size: 24px;
}

#lblText {
    font-size: 16px;
}

#lblError {
    font-size: 12px;
    color: rgba(244, 67, 54, 1);
}

#btnResendCode,
#btnSkip,
#btnAllowAccess {
    border: none;
    color: #1976D2;
    font-size: 14px;
}

#btnResendCode:disabled,
#btnSkip:disabled,
#btnAllowAccess:disabled {
    border: none;
    color: #9E9E9E;
    font-size: 14px;
}

#btnResendCode:hover,
#btnSkip:hover,
#btnAllowAccess:hover {
    background: rgba(30, 136, 229, 0.12);
    border: 1px solid transparent;
    border-radius: 20px;
}

#btnResendCode:pressed,
#btnSkip:pressed,
#btnAllowAccess:pressed {
    background: rgba(30, 136, 229, 0.3);
    border: 1px solid transparent;
    border-radius: 20px;
}
