#frame,
#frameHalign,
#frameContent,
#frameButton,
#frameLogo,
#frameText,
#frameToolbar {
    border: none;
}

#lblHeader {
    font-size: 22px;
    font: "Segoe UI";
}

#lblInfo1,
#lblInfo2,
#lblInfo3,
#lblInfo4,
#lblInfo5,
#lblInfo6,
#lblInfo7 {
    font-size: 14px;
}

#btnUnused {
    background: transparent;
    border: 1px solid transparent;
}

#btnBack {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 20px;
}

[theme="light"] #frameContent {
    background-color: #FFFFFF;
    border-radius: 24px;
}

/**** Retry button */
[theme="light"] #btnRetry {
    background: #1976D2;
    border-color: transparent;
    border-width: 1px;
    border-radius: 20px;
    color: #FFFFFF;
    font-size: 14px;
    font: "Segoe UI";
}

[theme="light"] #btnRetry:hover {
    background: rgba(30, 136, 229, 1);
}

[theme="light"] #btnRetry:pressed {
    background: rgba(20, 92, 164, 1);
}

[theme="light"] #btnRetry:disabled {
    background: #EEEEEE;
    color: #9E9E9E;
}

[theme="light"] #btnBack:hover {
    background: rgba(30, 136, 229, 0.12);
}

[theme="light"] #btnBack:pressed {
    background: rgba(30, 136, 229, 0.3);
}

[theme="dark"] #frameContent {
    background-color: #262729;
    border-radius: 24px;
}

/**** Retry button */
[theme="dark"] #btnRetry {
    background: #64B5F6;
    border-color: transparent;
    border-width: 1px;
    border-radius: 20px;
    color: #212121;
    font-size: 14px;
}

[theme="dark"] #btnRetry:hover {
    background: rgba(144, 202, 249, 1);
}

[theme="dark"] #btnRetry:pressed {
    background: rgba(53, 158, 243, 1);
}

[theme="dark"] #btnRetry:disabled {
    background: #616161;
    color: #9E9E9E;
}

[theme="dark"] #btnBack:hover {
    background: rgba(144, 202, 249, 0.12);
}

[theme="dark"] #btnBack:pressed {
    background: rgba(144, 202, 249, 0.3);
}
