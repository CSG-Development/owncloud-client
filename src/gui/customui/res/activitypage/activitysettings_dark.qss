QTabWidget {
    border: none;
}

QTabWidget::pane {
    top: -1px;
    border: 1px solid #616161;
    position: absolute;
    background: #262729;
}

QTabBar::tab {
    border: 1px solid #616161;
    min-height: 32px;
    padding-left: 12px;
    padding-right: 12px;
    margin-left: -1px;
    margin-right: -1px;
}

QTabBar::tab:selected  {
    background-color: #262729;
    border-left-color: #616161;
    border-right-color: #616161;
    border-top-color: #616161;
    border-bottom-color: #262729;
    margin-left: -1px;
    margin-right: -1px;
}

QTabBar::tab:!selected  {
    background-color: #3D3E41;
    border-color: #616161;
}

QTabBar::tab:first {
    border-top-left-radius: 4px;
    margin-left: 0px;
}

QTabBar::tab:last {
    border-top-right-radius: 4px;
    margin-right: 0;
}

QTabBar::tab:first:selected {
    margin-left: 0;
}

QTabBar::tab:last:selected {
    border-top-right-radius: 4px;
    margin-right: 0;
}

