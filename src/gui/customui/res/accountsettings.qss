#_folderList::indicator {
     width: 16px;
     height: 20px;
}

#_folderList::item:focus {
    outline: none;
    border: none;
}

#_folderList::branch {
    background: transparent;
    image: none;
}

QAbstractItemView {
    icon-size: 20px;
}

[theme="light"] #_folderList {
    /*show-decoration-selected: 1;*/
    border: 1px solid rgba(203, 205, 211, 1);
    background-color: #FFFFFF;
    color: rgba(0, 0, 0, 0.87);
}

[theme="light"] #_folderList::indicator:checked { image: url(:/res/checkbox_win/light/normal/checked.svg); }
[theme="light"] #_folderList::indicator:unchecked { image: url(:/res/checkbox_win/light/normal/unchecked.svg); }
[theme="light"] #_folderList::indicator:checked:hover { image: url(:/res/checkbox_win/light/hover/checked.svg); }
[theme="light"] #_folderList::indicator:unchecked:hover { image: url(:/res/checkbox_win/light/hover/unchecked.svg); }
[theme="light"] #_folderList::indicator:checked:pressed { image: url(:/res/checkbox_win/light/pressed/checked.svg); }
[theme="light"] #_folderList::indicator:unchecked:pressed { image: url(:/res/checkbox_win/light/pressed/unchecked.svg); }
[theme="light"] #_folderList::indicator:checked:disabled { image: url(:/res/checkbox_win/light/disabled/checked.svg); }
[theme="light"] #_folderList::indicator:unchecked:disabled { image: url(:/res/checkbox_win/light/disabled/unchecked.svg); }

[theme="light"] #_folderList::item:selected:active,
[theme="light"] #_folderList::item:selected:!active {
    background: rgba(25, 118, 210, 0.24);
    color: rgba(0, 0, 0, 0.87);
}

[theme="light"] #_folderList::branch:selected {
    background: rgba(25, 118, 210, 0.24);
    image: none;
}

[theme="dark"] #_folderList {
    border: 1px solid rgba(97, 97, 97, 1);
    background-color: #2D2D2D;
    color: rgba(255, 255, 255, 0.87);
}

[theme="dark"] #_folderList::indicator:checked { image: url(:/res/checkbox_win/dark/normal/checked.svg); }
[theme="dark"] #_folderList::indicator:unchecked { image: url(:/res/checkbox_win/dark/normal/unchecked.svg); }
[theme="dark"] #_folderList::indicator:checked:hover { image: url(:/res/checkbox_win/dark/hover/checked.svg); }
[theme="dark"] #_folderList::indicator:unchecked:hover { image: url(:/res/checkbox_win/dark/hover/unchecked.svg); }
[theme="dark"] #_folderList::indicator:checked:pressed { image: url(:/res/checkbox_win/dark/pressed/checked.svg); }
[theme="dark"] #_folderList::indicator:unchecked:pressed { image: url(:/res/checkbox_win/dark/pressed/unchecked.svg); }
[theme="dark"] #_folderList::indicator:checked:disabled { image: url(:/res/checkbox_win/dark/disabled/checked.svg); }
[theme="dark"] #_folderList::indicator:unchecked:disabled { image: url(:/res/checkbox_win/dark/disabled/unchecked.svg); }

[theme="dark"] #_folderList::item:selected:active,
[theme="dark"] #_folderList::item:selected:!active {
    background: rgba(100, 181, 246, 0.24);
    color: rgba(255, 255, 255, 0.87);
}

[theme="dark"] #_folderList::branch:selected {
    background: rgba(100, 181, 246, 0.24);
    image: none;
}
