#mainFrame {
    border: none;
}

#inputFrame {
    border: 1px solid rgba(244, 67, 54, 1);
    border-radius: 20px;
}

#inputFrame[focusedFrame=true] {
    border: 3px solid rgba(244, 67, 54, 1);
}

#inputFrame[focusedFrame=false] {
    border: 1px solid rgba(244, 67, 54, 1);
}

#errorFrame {
    border: none;
}

#inputLineEdit {
    border: none;
    border-radius: 0px;
    background: transparent;
    font-size: 16px;
}

#promptLabel {
    color: #F44336;
    background: #FFFFFF;
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 4px;
    padding-right: 4px;
    font-size: 12px;
}

#errorLabel {
    color: #F44336;
    background: #FFFFFF;
    font-size: 12px;
    padding-left: 4px;
}

#showPasswordButton {
    border: none;
}
