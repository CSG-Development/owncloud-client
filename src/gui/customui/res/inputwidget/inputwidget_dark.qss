#mainFrame {
    border: none;
}

#inputFrame {
    border: 1px solid rgba(97, 97, 97, 1);
    border-radius: 20px;
}

#inputFrame[focusedFrame=true] {
    border: 3px solid rgba(100, 181, 246, 1);
}

#inputFrame[focusedFrame=false] {
    border: 1px solid rgba(97, 97, 97, 1);
}

#errorFrame {
    border: none;
}

#inputLineEdit {
    border: none;
    border-radius: 0px;
    background: transparent;
    font-size: 16px;
}

#promptLabel {
    color: rgba(255,255,255,204);
    background-color: #262729;
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 4px;
    padding-right: 4px;
    border: 1px solid transparent;
}

#errorLabel {
    color: #F28F8C;
    background: transparent;
}

#showPasswordButton {
    border: none;
}
