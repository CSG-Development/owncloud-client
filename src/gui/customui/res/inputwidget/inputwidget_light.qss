#frame {
    border: 1px solid #CBCDD3;
    border-radius: 20px;
}

#lineEdit {
    border: none;
    border-radius: 0px;
    background: rgba(0,0,0,0);
    font-size: 16px;
}

#prompt {
    color: rgba(0,0,0,204);
    background: #FFFFFF;
    padding-left: 4px;
    padding-right: 4px;
}

#btnPassword {
    border: none;
}
