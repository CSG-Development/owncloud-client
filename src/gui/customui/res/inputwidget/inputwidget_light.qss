#mainFrame {
    border: none;
}

#inputFrame {
    border: 1px solid #CBCDD3;
    border-radius: 20px;
}

#errorFrame {
    border: none;
}

#inputLineEdit {
    border: none;
    border-radius: 0px;
    background: rgba(0,0,0,0);
    font-size: 16px;
}

#promptLabel {
    color: rgba(0,0,0,204);
    background: #FFFFFF;
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 4px;
    padding-right: 4px;
}

#errorLabel {
    color: #F44336;
    background: #FFFFFF;
}

#showPasswordButton {
    border: none;
}
