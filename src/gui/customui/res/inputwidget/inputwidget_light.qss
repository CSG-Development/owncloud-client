#mainFrame {
    border: none;
}

#inputFrame {
    border: 1px solid rgba(203, 205, 211, 1);
    border-radius: 20px;
}

#inputFrame[focusedFrame=true] {
    border: 3px solid rgba(25, 118, 210, 1);
}

#inputFrame[focusedFrame=false] {
    border: 1px solid rgba(203, 205, 211, 1);
}

#errorFrame {
    border: none;
}

#inputLineEdit {
    border: none;
    border-radius: 0px;
    background: transparent;
    font-size: 16px;
}

#promptLabel {
    color: rgba(0,0,0,204);
    background: #FFFFFF;
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 4px;
    padding-right: 4px;
}

#errorLabel {
    color: #F44336;
    background: #FFFFFF;
}

#showPasswordButton {
    border: none;
}
