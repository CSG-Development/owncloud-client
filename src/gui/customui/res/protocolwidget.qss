#ProtocolWidgetPopup::indicator {
    width: 8px;
    height: 8px;
    left: 6px;
    background: transparent;
    border: 0px solid transparent;
    outline: none;
}

#ProtocolWidgetPopup::item {
    padding: 4px 16px 4px 16px;
}

#ProtocolWidgetPopup::indicator:unchecked {
    image: none;
}

[theme="light"] #ProtocolWidgetPopup {
    color: rgba(0, 0, 0, 0.87);
    background: #FFFFFF;
}

[theme="light"] #ProtocolWidgetPopup::item:selected:enabled {
    background: @menuSelectionBackgroundLight;
    color: @onMenuSelectionLight;
}

[theme="light"] #ProtocolWidgetPopup::item:disabled {
    color: rgba(158, 158, 158, 1);
}

[theme="light"] #ProtocolWidgetPopup::indicator:checked { image: url(:/res/menu/check_light.svg); }

[theme="dark"] #ProtocolWidgetPopup {
    color: rgba(255, 255, 255, 0.87);
    background: #424242;
}

[theme="dark"] #ProtocolWidgetPopup::item:selected:enabled {
    background: @menuSelectionBackgroundDark;
    color: @onMenuSelectionDark;
}

[theme="dark"] #ProtocolWidgetPopup::item:disabled {
    color: rgba(158, 158, 158, 1);
}

[theme="dark"] #ProtocolWidgetPopup::indicator:checked { image: url(:/res/menu/check_dark.svg); }
