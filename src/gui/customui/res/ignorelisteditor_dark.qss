QTableWidget::indicator {
    width: 16px;
    height: 20px;
}

QTableWidget::indicator:checked {
    image: url(:/res/checkbox/dark/normal/checked.svg);
}

QTableWidget::indicator:unchecked {
    image: url(:/res/checkbox/dark/normal/unchecked.svg);
}

QTableWidget::indicator:checked:hover {
    image: url(:/res/checkbox/dark/hover/checked.svg);
}

QTableWidget::indicator:unchecked:hover {
    image: url(:/res/checkbox/dark/hover/unchecked.svg);
}

QTableWidget::indicator:checked:pressed {
    image: url(:/res/checkbox/dark/pressed/checked.svg);
}

QTableWidget::indicator:unchecked:pressed {
    image: url(:/res/checkbox/dark/pressed/unchecked.svg);
}

QTableWidget::indicator:checked:disabled {
    image: url(:/res/checkbox/dark/disabled/checked.svg);
}

QTableWidget::indicator:unchecked:disabled {
    image: url(:/res/checkbox/dark/disabled/unchecked.svg);
}

QAbstractItemView {
    icon-size: 20px;
}
